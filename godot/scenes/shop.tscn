transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.2, 0, -0.2)
script = ExtResource("2_0tlss")
prompt_text = "[E] Мутный эликсир"
dialogue_lines = PackedStringArray("Склянка тёплая. Жидкость медленно переливается сама.", "Тебе суют бумажный пропуск: «В Центральную — пока не передумали.»", "(3D лавки автор пришлёт позже. Сейчас — заглушка выбора.)")
choice_id = "potion"
change_scene_to = "res://scenes/central_library.tscn"

